{
    "name": "dem1-off/laravel-modular",
    "description": "Modular architecture tools for Laravel — DDD modules that promote to standalone packages with zero code churn",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "modules",
        "modular",
        "ddd",
        "architecture"
    ],
    "authors": [
        {
            "name": "Dmytro Dohryk",
            "email": "dmitro.dohryk@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "Dem1Off\\LaravelModular\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Dem1Off\\LaravelModular\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dem1Off\\LaravelModular\\LaravelModularServiceProvider"
            ],
            "aliases": {
                "Modules": "Dem1Off\\LaravelModular\\Facades\\Modules"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}